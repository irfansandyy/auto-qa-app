APP_NAME="Auto QA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://qa-app.eastasia.cloudapp.azure.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

AUTH_REGISTRATION_ENABLED=true
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1860
# Switch to smtp and fill in the verified sender and relay credentials for password recovery.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_REQUIRE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

BROWSER_WORKER_URL=http://127.0.0.1:3001
BROWSER_WORKER_HOST=127.0.0.1
BROWSER_WORKER_PORT=3001
BROWSER_WORKER_TOKEN=
BROWSER_WORKER_TIMEOUT=45
AUTOQA_LOCAL_TARGETS=
AUTOQA_MAX_STEPS=25

# Leave unused providers empty. Loopback here is the container, not the VM host.
MODEL_URL=
MODEL_NAME=
MODEL_API_KEY=
# Managed Google AI Studio keys, in preference order.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Leave empty for the built-in model order. Thinking is selected automatically.
GEMINI_MODELS=
# Managed fallback gateway: https://senopati.lab-alpro.com/llm-gateway/v1
SENOPATI_API_KEY=
SENOPATI_MODEL=qwen3:14b

# Optional installed GitHub App. Mount its key under /run/autoqa-secrets.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=
AUTOQA_REPOSITORY_ACCESS='{}'
